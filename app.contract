// Flashcard Exact: the view. app.ts answers what it asks for. Colours, fonts,
// sizes and the safe area are left unsaid, so each platform supplies its own:
// the header is the navigation bar, its heading the title, its button a bar item.
shape Flashcard
  id: number
  title: string
  body: string

shape FlashcardPage
  cards: Flashcard[]
  after: option<string>

fn loadMessage(code: string): string = code == "offline" ? "Can't reach the server." : code == "timeout" ? "The server took too long to respond." : "Couldn't load flashcards."

routes nav
  home "/"
    add "/add"

component FlashcardExact
  state flashcards = []
  state after: option<string> = none
  state atEnd = false
  mutation fetched as shape FlashcardPage then updateFlashcards
  mutation more as shape FlashcardPage then appendFlashcards
  task load mount
    after(1, fetch)
  action fetch
    send fetched = loadFlashcards()
  action updateFlashcards
    flashcards = match fetched { case some(page) => page.cards, case none => flashcards }
    after = match fetched { case some(page) => page.after, case none => after }
  action appendFlashcards
    flashcards = match more { case some(page) => flashcards.concat(page.cards), case none => flashcards }
    after = match more { case some(page) => page.after, case none => after }
  derive lastId = match flashcards.at(-1) { case some(c) => c.id, case none => -1 }
  // The last card within 400pt of the bottom: time for the next page.
  action seen(id: number, entry: IntersectionObserverEntry)
    if id == lastId
      atEnd = entry.isIntersecting
  derive hasMore = match after { case some(c) => true, case none => false }
  task next when atEnd && hasMore && not pending(fetched) && not pending(more) && not failed(more)
    after(1, fetchMore)
  action fetchMore
    match after
      case some(cursor)
        send more = loadMoreFlashcards(cursor)
      case none
        atEnd = false
  state loadError = ""
  state draftTitle = ""
  state draftBody = ""
  derive canSave = draftTitle.trim() != "" && draftBody.trim() != ""
  task loadFailed when failed(fetched)
    after(1, showLoadError)
  action showLoadError
    let code = match failure(fetched) {
      case some(f) => f.code,
      case none => "",
    }
    loadError = loadMessage(code)
    showModal("load-error")
  task moreFailed when failed(more)
    after(1, showMoreError)
  action showMoreError
    let code = match failure(more) {
      case some(f) => f.code,
      case none => "",
    }
    atEnd = false
    loadError = loadMessage(code)
    showModal("load-error")
  action openAdd
    draftTitle = ""
    draftBody = ""
    nav = push(nav, "/add")
  action editTitle(v: string)
    draftTitle = v
  action editBody(v: string)
    draftBody = v
  action back
    nav = back(nav)
  action save
    if canSave
      let nextId = match sortBy(flashcards, c => c.id).at(-1) { case some(last) => last.id + 1, case none => 1 }
      flashcards = flashcards.concat([Flashcard(id=nextId, title=draftTitle.trim(), body=draftBody.trim())])
      nav = back(nav)
  action remove(id: number)
    flashcards = flashcards.filter(flashcard => flashcard.id != id)
  view
    main testId="root"
      navigationKey=`${top(nav).id}`
      navigationBack="back"
      width="100%"
      height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}`
            navigationScroll="content"
            position="absolute"
            inset=0
            display="flex"
            flex-direction="column"
            header display="flex" align-items="center"
              text "Flashcards" role="heading" aria-level=1 flex=1
              button press=openAdd disabled=pending(fetched) aria-label="Add flashcard" testId="add"
                image "symbol:add"
            list id="content"
              testId="list"
              appearance="auto"
              listStyle="inset-grouped"
              flex=1
              min-height=0
              -exact-scroll-edge-effect="soft"
              refresh=fetch
              refreshing=(pending(fetched) && flashcards.length > 0)
              section
                for flashcard in flashcards key=flashcard.id
                  row delete=remove(flashcard.id)
                    intersect=seen(flashcard.id)
                    intersect-margin="0px 0px 400px 0px"
                    testId=`card-${flashcard.id}`
                    column gap=4
                      text flashcard.title font-weight=600
                      text flashcard.body
                footer
                  text (pending(more) ? "Loading more…" : "") testId="footer"
            if pending(fetched) && flashcards.length == 0
              column position="absolute"
                inset=0
                display="flex"
                align-items="center"
                justify-content="center"
                gap=8
                testId="loading"
                progress aria-label="Loading flashcards"
                text "Loading" color="-exact-secondary-label"
            column id="menu" popover="auto" role="menu"
              button destructive=true popovertarget="menu" popovertargetaction="hide"
                image "symbol:delete"
                text "Delete"
            dialog id="load-error" role="alertdialog" aria-label="Couldn't Load Flashcards"
              text loadError testId="load-error-message"
              button commandfor="load-error" command="close" testId="load-error-ok"
                text "OK"
        if e.name == "add"
          column navigationKey=`${e.id}`
            navigationPresentation="modal"
            navigationDetent="large"
            position="absolute"
            inset=0
            header display="flex" align-items="center"
              button id="back" press=back aria-label="Close" testId="close"
                image "symbol:close"
              text "New Flashcard" role="heading" flex=1
              button press=save
                buttonStyle="prominent-glass"
                disabled=(not canSave)
                aria-label="Save"
                testId="save"
                image "symbol:checkmark"
            list id="add-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row
                  input value=draftTitle
                    input=editTitle
                    placeholder="Title"
                    aria-label="Title"
                    autocapitalize="sentences"
                    autofocus=true
                    testId="title"
                    flex=1
                    min-width=0
                row
                  textarea value=draftBody
                    input=editBody
                    placeholder="Body"
                    aria-label="Body"
                    rows=4
                    testId="body"
                    flex=1
                    min-width=0
